FROM node:22-bookworm-slim AS build
WORKDIR /opt/web
COPY source/web/apps/web/package.json source/web/apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY source/web/apps/web/ ./
COPY source/web/contracts/ /contracts/
ENV API_BASE_URL=http://127.0.0.1:8000 NEXT_TELEMETRY_DISABLED=1
RUN npm run test:workbench && npm run build
FROM node:22-bookworm-slim
WORKDIR /opt/web
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
COPY --from=build --chown=node:node /opt/web/.next/standalone/ ./
COPY --from=build --chown=node:node /opt/web/.next/static/ ./.next/static/
USER node
CMD ["node", "server.js"]
