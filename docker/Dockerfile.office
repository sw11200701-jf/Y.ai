FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
      libreoffice-writer libreoffice-calc libreoffice-impress python3-uno fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/* \
    && install -d -o 10001 -g 10001 -m 0700 /run/office
COPY converter/ /opt/document-converter/
USER 10001:10001
ENTRYPOINT ["/usr/bin/python3", "/opt/document-converter/socket_service.py"]
